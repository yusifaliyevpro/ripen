{
  "name": "ripencli",
  "version": "1.4.4",
  "description": "Interactive dependency updater for npm, pnpm, yarn, and bun",
  "keywords": [
    "bun",
    "cli",
    "dependencies",
    "interactive",
    "npm",
    "outdated",
    "package-manager",
    "pnpm",
    "tui",
    "update",
    "updater",
    "upgrade",
    "yarn"
  ],
  "homepage": "https://ripencli.vercel.app",
  "bugs": {
    "url": "https://github.com/yusifaliyevpro/ripen/issues"
  },
  "license": "LGPL-2.1-or-later",
  "author": {
    "name": "Yusif Aliyev",
    "email": "yusifaliyevpro@gmail.com",
    "url": "https://yusifaliyevpro.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusifaliyevpro/ripen.git"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/yusifaliyevpro"
    },
    {
      "type": "kofe.al",
      "url": "https://kofe.al/@yusifaliyevpro"
    }
  ],
  "bin": {
    "ripen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "pnpm --prefix docs dev",
    "docs:build": "pnpm --prefix docs build",
    "docs:start": "pnpm --prefix docs start",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "execa": "10.0.1",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "greenly": "1.1.5",
    "ink-scroll-view": "0.3.7",
    "ink-testing-library": "4.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
